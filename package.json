{
  "name": "tidslinje",
  "private": true,
  "type": "module",
  "description": "Världstidslinje 1000–idag, renderad från YAML och Markdown",
  "scripts": {
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "npm run check && npm run build && npm run smoke",
    "serve": "npm run build && npx --yes http-server _site -p 8080 -c-1"
  },
  "devDependencies": {
    "dompurify": "3.1.6",
    "js-yaml": "4.1.0",
    "marked": "12.0.2",
    "playwright": "1.56.0"
  }
}
